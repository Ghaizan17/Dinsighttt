{
  "name": "dinsight",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "wasmer:build": "vite build",
    "wasmer:deploy": "vite build && wasmer deploy",
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev:api": "node --env-file-if-exists=.env server/index.js",
    "db:local": "bash scripts/local-db.sh start",
    "db:stop": "bash scripts/local-db.sh stop",
    "db:status": "bash scripts/local-db.sh status",
    "dev:all": "bash scripts/local-db.sh start && (npm run dev:api & npm run dev; kill %1 2>/dev/null || true)"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.344.0",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^8.3.8"
  }
}
